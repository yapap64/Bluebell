{
  "name": "mi-musica",
  "version": "1.0.0",
  "description": "Reproductor de música personal, sin anuncios",
  "main": "electron/main.js",
  "author": "Mi música",
  "license": "MIT",
  "scripts": { "start": "electron ." },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.mimusica.player",
    "productName": "Mi música",
    "files": ["electron/**", "www/**", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "MiMusica-Instalador-${version}.${ext}" },
    "portable": { "artifactName": "MiMusica-Portable-${version}.${ext}" }
  }
}

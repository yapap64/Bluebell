{
  "name": "bluebell",
  "version": "1.0.0",
  "description": "A personal music player with no ads",
  "main": "electron/main.js",
  "author": "Bluebell",
  "license": "MIT",
  "scripts": { "start": "electron ." },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.bluebell.player",
    "productName": "Bluebell",
    "files": ["electron/**", "www/**", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Bluebell-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Bluebell-Portable-${version}.${ext}" }
  }
}
